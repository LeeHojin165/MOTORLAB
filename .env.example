# ── LLM / 임베딩 (OpenAI 호환) ──────────────────────────
OPENAI_API_KEY=
# SSAFY GMS를 쓸 때는 아래 주석을 풀고 GMS 키를 OPENAI_API_KEY에 넣는다
# OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# Claude 호출 주소 (GMS는 OpenAI 키와 같은 키 사용)
# ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com/v1
# 답변 생성 기본 모델 / 검색어 추출·후보 선별 모델 / 화면에서 고를 수 있는 모델
ANSWER_MODEL=gpt-4o
UTILITY_MODEL=gpt-4o-mini
MODELS=gpt-4o,gpt-4o-mini,claude-sonnet-4-5-20250929
EMBEDDING_MODEL=text-embedding-3-small

# ── 청킹 · 검색 ────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
SEARCH_TYPE=similarity
MMR_FETCH_K=20
MMR_LAMBDA=0.5

# ── 문서 수집 (위키백과) ───────────────────────────────
# 위키미디어 정책상 User-Agent에 연락처를 넣는다 (이메일 또는 저장소 URL)
WIKI_CONTACT=
WIKI_INTERVAL=1.0
MAX_QUERIES=3
SEARCH_PER_QUERY=4
# 1이면 외부 호출 없이 제공된 문서 묶음만 사용
OFFLINE_COLLECT=0
